generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String
  role          Role     @default(user)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorEmail String
  action     String
  details    String
  createdAt  DateTime @default(now())
}